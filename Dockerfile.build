# Builds libredesk from source (frontend + backend + embedded assets) in one image.
# Used by docker-compose.build.yml. The upstream Dockerfile expects a prebuilt binary.

FROM node:22-alpine AS frontend
WORKDIR /src/frontend
ENV CYPRESS_INSTALL_BINARY=0 \
    PUPPETEER_SKIP_DOWNLOAD=1 \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
COPY static/ /src/static/
COPY i18n/ /src/i18n/
ARG LIBREDESK_VERSION=v2.10.0-rc.3-telegram
ENV VITE_APP_VERSION=${LIBREDESK_VERSION}
RUN pnpm build:main && pnpm build:widget && pnpm build:widget-loader

FROM golang:1.27-alpine AS backend
WORKDIR /src
ENV GOTOOLCHAIN=auto CGO_ENABLED=0
RUN apk add --no-cache git
COPY go.mod go.sum ./
RUN go mod download
RUN go install github.com/knadh/stuffbin/...@latest
COPY . .
COPY --from=frontend /src/frontend/dist ./frontend/dist
COPY --from=frontend /src/static/widget.min.js ./static/widget.min.js
ARG LIBREDESK_VERSION=v2.10.0-rc.3-telegram
RUN go build \
      -ldflags="-s -w -X 'main.buildString=${LIBREDESK_VERSION} (telegram)' -X 'main.versionString=${LIBREDESK_VERSION}' -X 'github.com/abhinavxd/libredesk/internal/version.Version=${LIBREDESK_VERSION}'" \
      -o libredesk ./cmd/ \
 && stuffbin -a stuff -in libredesk -out libredesk \
      frontend/dist i18n schema.sql static/email-templates static/public static/widget.min.js:static/widget.js

FROM alpine:3.21
RUN apk --no-cache add ca-certificates tzdata
WORKDIR /libredesk
COPY --from=backend /src/libredesk .
COPY config.sample.toml config.toml
EXPOSE 9000
CMD ["./libredesk"]
